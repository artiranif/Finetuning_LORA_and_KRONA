# Template for `.env` — copy to `.env` and fill in.  ONLY `.env` is actually read.
#   cp .env.mock .env
#
# `.env` is git-ignored; this file is versioned on purpose.

# --- Hugging Face -----------------------------------------------------------------
# A READ token. Only needed for gated repos; `unsloth/gemma-3-1b-it` is public,
# so it may be left empty (the run works anonymously).
HF_TOKEN=

# --- Overrides for the default config in krona/config.py --------------------------
# Every key below is OPTIONAL: comment it out to use the code default.
# Environment variables all use the KRONA_ prefix.

# KRONA_MODEL=unsloth/gemma-3-1b-it
# KRONA_LOAD_IN_4BIT=false        # false is REQUIRED for KronA (LoKr breaks on 4-bit)
# KRONA_DATASET=databricks/databricks-dolly-15k
# KRONA_MAX_SAMPLES=1000
# KRONA_EVAL_SIZE=64
# KRONA_MAX_SEQ=512
# KRONA_STEPS=60
# KRONA_BATCH_SIZE=2
# KRONA_GRAD_ACCUM=4
# KRONA_LR=0.0002
# KRONA_EVAL_EVERY=20
# KRONA_RANK=16
# KRONA_ALPHA=32
# KRONA_SEED=42

# --- Outputs ----------------------------------------------------------------------
# Where adapters/checkpoints are written. RunPod convention is /workspace
# (a network volume survives pod restarts; the container filesystem does not).
# KRONA_OUT_DIR=outputs
